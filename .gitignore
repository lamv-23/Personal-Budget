# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (commit .env.example, not .env)
.env
.env.local
.env.production

# uploaded documents (local dev — UPLOAD_DIR=./uploads). In prod these live in a Docker volume.
/uploads/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
