# --- Database ---
# Strong password — generate with: openssl rand -base64 24
POSTGRES_PASSWORD=change-me-to-a-strong-password
DATABASE_URL=postgres://budget:change-me-to-a-strong-password@db:5432/budget

# --- Auth.js ---
# Session secret — generate with: openssl rand -base64 32
AUTH_SECRET=run-openssl-rand-base64-32-and-paste-here
# Your final HTTPS URL via Tailscale Serve (hostname + tailnet)
AUTH_URL=https://vlam-pi.tailf0621c.ts.net
# Google OAuth client from console.cloud.google.com (Credentials → Web application)
AUTH_GOOGLE_ID=your-google-oauth-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=GOCSPX-your-google-oauth-client-secret

# Allowed Google accounts (comma-separated emails). Anyone else hitting sign-in
# is rejected by the signIn callback in lib/auth.ts.
ALLOWED_EMAILS=lamv23@gmail.com,wife@example.com

# --- AI extraction ---
EXTRACTION_PROVIDER=gemini
# From aistudio.google.com → "Get API key" → "Create API key"
GEMINI_API_KEY=AIzaSy-your-gemini-key-from-ai-studio
GEMINI_MODEL=gemini-2.5-flash

# Optional: Anthropic (only if you set EXTRACTION_PROVIDER=anthropic to A/B against Haiku 4.5)
# ANTHROPIC_API_KEY=

# --- File uploads ---
UPLOAD_DIR=/data/uploads
