# Database
POSTGRES_PASSWORD=change-me-to-a-strong-password
DATABASE_URL=postgres://budget:change-me@db:5432/budget

# Auth.js
AUTH_SECRET=run-openssl-rand-base64-32-and-paste-here
AUTH_URL=https://budget.<your-tailnet>.ts.net
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# Allowed Google accounts (comma-separated emails)
ALLOWED_EMAILS=your@email.com,partner@email.com

# AI extraction
EXTRACTION_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-from-ai-studio
GEMINI_MODEL=gemini-2.5-flash

# Optional: Anthropic (only if EXTRACTION_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=

# File uploads
UPLOAD_DIR=/data/uploads
